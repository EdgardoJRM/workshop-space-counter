# --- Ya en Vercel (integración / manual) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
ADMIN_TOKEN=

# Solo esto suele faltar tras integración Supabase↔Vercel:
# Supabase → Settings → Database → password (o Reset)
POSTGRES_PASSWORD=

# Opcional si tu pooler no está en us-east-1:
# SUPABASE_DB_REGION=sa-east-1

# El resto lo trae Vercel al hacer: npm run env:pull:production
# (POSTGRES_HOST, POSTGRES_USER, SUPABASE_URL, etc.)
# No hace falta pegar POSTGRES_PRISMA_URL a mano — se arma sola.

APP_BASE_URL=https://pass.edgardohernandez.com
CLICKFUNNELS_WEBHOOK_SECRET=
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
EMAIL_FROM=Hernandez Pass <pass@tudominio.com>
ADMIN_EMAILS=
STAFF_EMAILS=
AUTH_JWT_SECRET=

# App Store / TestFlight review — demo login (mobile app only)
# APP_REVIEW_DEMO_EMAIL=appreview@example.com
# APP_REVIEW_DEMO_PASSWORD=use-a-strong-password-here

# La Bóveda — otorgar acceso a libros tras check-in exitoso
# Ej: https://boveda.edgardohernandez.com/api/webhooks/access/hernandez-pass?org=edgardo
LA_BOVEDA_WEBHOOK_URL=
LA_BOVEDA_WEBHOOK_SECRET=

# Vercel Cron — Authorization: Bearer <CRON_SECRET> en /api/cron/send-emails
CRON_SECRET=

# Certificados (desactivado por defecto)
# CERTIFICATES_ENABLED=true
# Cuándo enviar el email: checkin (al escanear) o post_workshop (cron al terminar el taller)
# CERTIFICATES_SEND_ON=checkin

# Opcional: miniatura de mapa en el email del pase (Google Static Maps)
GOOGLE_MAPS_API_KEY=

# Agente Impresora Auto (Mac con Rollo) — polling de cola de impresión
PRINT_AGENT_TOKEN=

# SaaS / Stripe (opcional hasta vender a otros negocios)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_EVENT_PRO=
STRIPE_PRICE_BUSINESS=
