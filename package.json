{
  "name": "workshop-space-counter",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "postinstall": "prisma generate",
    "db:push": "node scripts/run-prisma.mjs db push",
    "db:migrate": "node scripts/run-prisma.mjs migrate dev",
    "db:seed": "node scripts/run-prisma.mjs db seed",
    "db:setup": "npm run db:push && npm run db:seed",
    "env:pull:production": "vercel env pull .env.vercel.production --environment=production --yes",
    "env:sync": "node scripts/sync-env-from-vercel.mjs",
    "verify:ses": "node scripts/verify-ses.mjs",
    "verify:ses:send": "node scripts/verify-ses.mjs --send-test",
    "test": "node --import tsx --test lib/**/*.test.ts",
    "sync:webhook-secret": "node scripts/sync-webhook-secret.mjs"
  },
  "prisma": {
    "seed": "npx tsx prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-ses": "^3.1061.0",
    "@prisma/client": "^5.22.0",
    "@types/qrcode": "^1.5.6",
    "@upstash/redis": "^1.34.3",
    "html5-qrcode": "^2.3.8",
    "jose": "^6.2.3",
    "next": "14.2.35",
    "prisma": "^5.22.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "stripe": "^17.7.0"
  },
  "devDependencies": {
    "@tailwindcss/forms": "^0.5.9",
    "@types/node": "^20.17.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "dotenv-cli": "^11.0.0",
    "eslint": "^8.57.1",
    "eslint-config-next": "14.2.35",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "tsx": "^4.22.4",
    "typescript": "^5.6.3"
  }
}
