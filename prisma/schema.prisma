generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

enum OrgRole {
  OWNER
  ADMIN
  STAFF
}

enum PlanTier {
  STARTER
  EVENT_PRO
  BUSINESS
}

enum RegistrationStatus {
  CONFIRMED
  CANCELLED
  REFUNDED
}

enum PrintJobStatus {
  PENDING
  PROCESSING
  PRINTED
  FAILED
}

enum WebhookEventStatus {
  RECEIVED
  PROCESSED
  FAILED
  DUPLICATE
}

enum GuestInfoRequestStatus {
  PENDING
  COMPLETED
  EXPIRED
}

model Organization {
  id                     String   @id @default(cuid())
  slug                   String   @unique
  name                   String
  displayName            String?
  appTitle               String?
  logoUrl                String?
  primaryColor           String?  @default("#1a1a1a")
  accentColor            String?  @default("#c9a227")
  supportEmail           String?
  customDomain           String?
  plan                   PlanTier @default(STARTER)
  stripeCustomerId       String?  @unique
  stripeSubscriptionId   String?  @unique
  subscriptionStatus     String?
  clickfunnelsSecret     String?
  legacyPrintAgentToken  String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  members        OrganizationMember[]
  workshops      Workshop[]
  attendees      Attendee[]
  emailTemplates EmailTemplate[]
  labelTemplates LabelTemplate[]
  webhookEvents  WebhookEvent[]
  printerAgents  PrinterAgent[]
  pairingCodes   PrinterPairingCode[]
  pushTokens        MobilePushToken[]
  guestInfoRequests GuestInfoRequest[]
}

model OrganizationMember {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           OrgRole
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([organizationId, email])
  @@index([email])
}

model PrinterAgent {
  id             String    @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String?
  tokenHash      String    @unique
  lastSeenAt     DateTime?
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([organizationId])
}

model PrinterPairingCode {
  id             String    @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  code           String    @unique
  expiresAt      DateTime
  usedAt         DateTime?
  createdAt      DateTime  @default(now())

  @@index([organizationId, expiresAt])
}

model Workshop {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  slug           String
  label          String
  description    String?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  dates          WorkshopDate[]

  @@unique([organizationId, slug])
  @@index([organizationId])
}

model WorkshopDate {
  id             String   @id @default(cuid())
  workshopId     String
  workshop       Workshop @relation(fields: [workshopId], references: [id], onDelete: Cascade)
  title          String?
  startsAt       DateTime
  venue          String?
  mapsUrl        String?
  capacity       Int      @default(25)
  soldCount      Int      @default(0)
  checkedInCount Int      @default(0)
  isActive       Boolean  @default(true)
  isSelling      Boolean  @default(false) // Fecha que recibe ventas/webhooks de ClickFunnels
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  registrations  Registration[]

  @@index([workshopId, isActive])
  @@index([workshopId, isSelling])
  @@index([startsAt])
}

model Attendee {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  name           String?
  phone          String?
  metadata       Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  registrations  Registration[]

  @@unique([organizationId, email])
  @@index([organizationId])
}

model Registration {
  id              String             @id @default(cuid())
  attendeeId      String
  attendee        Attendee           @relation(fields: [attendeeId], references: [id], onDelete: Cascade)
  workshopDateId  String
  workshopDate    WorkshopDate       @relation(fields: [workshopDateId], references: [id], onDelete: Cascade)
  externalOrderId String?
  attendeeName    String?
  attendeeEmail   String?
  attendeePhone   String?
  source          String?
  metadata        Json?
  status          RegistrationStatus @default(CONFIRMED)
  registeredAt    DateTime           @default(now())
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  pass            Pass?
  certificate     Certificate?
  checkins        Checkin[]
  emailLogs       EmailLog[]
  printJobs       PrintJob[]
  guestInfoRequestAsBuyer GuestInfoRequest? @relation("BuyerRegistration")

  @@unique([externalOrderId])
  @@index([workshopDateId])
  @@index([attendeeId])
  @@index([attendeeEmail])
}

model EmailTemplate {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  subject        String
  htmlBody       String   @db.Text
  delayHours     Int
  /// event_start | checkin
  anchor         String   @default("event_start")
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  logs           EmailLog[]

  @@index([organizationId])
}

model EmailLog {
  id             String        @id @default(cuid())
  templateId     String
  template       EmailTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  registrationId String
  registration   Registration  @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  sentAt         DateTime      @default(now())
  status         String
  error          String?

  @@unique([templateId, registrationId])
  @@index([templateId])
  @@index([registrationId])
}

model Pass {
  id             String       @id @default(cuid())
  registrationId String       @unique
  registration   Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  tokenHash      String       @unique
  emailedAt      DateTime?
  emailError     String?
  revoked        Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model Certificate {
  id             String       @id @default(cuid())
  registrationId String       @unique
  registration   Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  tokenHash      String       @unique
  emailedAt      DateTime?
  emailError     String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([registrationId])
}

model Checkin {
  id             String       @id @default(cuid())
  registrationId String       @unique
  registration   Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  checkedInBy    String?
  userAgent      String?
  createdAt      DateTime     @default(now())
  printJob       PrintJob?

  @@index([registrationId])
}

model PrintJob {
  id             String         @id @default(cuid())
  organizationId String
  registrationId String
  registration   Registration   @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  checkinId      String?        @unique
  checkin        Checkin?       @relation(fields: [checkinId], references: [id], onDelete: SetNull)
  status         PrintJobStatus @default(PENDING)
  trigger        String
  payload        Json
  attempts       Int            @default(0)
  printedAt      DateTime?
  error          String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([organizationId, status, createdAt])
  @@index([registrationId])
}

model LabelTemplate {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workshopSlug   String?
  fontLarge      Int      @default(160)
  fontSmall      Int      @default(80)
  mediaSize      String   @default("3x2")
  showEmail      Boolean  @default(false)
  showWorkshop   Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([organizationId, workshopSlug])
  @@index([organizationId])
}

model GuestInfoRequest {
  id                  String                 @id @default(cuid())
  organizationId      String
  organization        Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  buyerRegistrationId String                 @unique
  buyerRegistration   Registration           @relation("BuyerRegistration", fields: [buyerRegistrationId], references: [id], onDelete: Cascade)
  externalOrderId     String
  tokenHash           String                 @unique
  slotsNeeded         Int
  slotsCompleted      Int                    @default(0)
  status              GuestInfoRequestStatus @default(PENDING)
  workshopSlug        String
  workshopDateId      String?
  expiresAt           DateTime
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt

  @@unique([organizationId, externalOrderId])
  @@index([organizationId, status])
}

model WebhookEvent {
  id             String             @id @default(cuid())
  organizationId String
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  provider       String             @default("clickfunnels")
  externalId     String
  payload        Json
  status         WebhookEventStatus @default(RECEIVED)
  error          String?
  createdAt      DateTime           @default(now())
  processedAt    DateTime?

  @@unique([organizationId, provider, externalId])
  @@index([organizationId, status])
}

model MobilePushToken {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  expoPushToken  String   @unique
  platform       String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId, email])
}
